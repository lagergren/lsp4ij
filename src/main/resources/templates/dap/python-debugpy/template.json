{
  "id": "python-debugpy",
  "name": "Python - Debugpy",
  "launch": {
    "windows": "python -m debugpy.adapter",
    "default": "python3 -m debugpy.adapter"
  },
  "attach": {
    "address": "$connect.host",
    "port": "$connect.port"
  },
  "fileTypeMappings": [
    {
      "fileType": {
        "patterns": [
          "*.py",
          "*.rpy",
          "*.pyw",
          "*.cpy",
          "*.gyp",
          "*.gypi",
          "*.pyi",
          "*.ipy",
          "*.pyt"
        ]
      }
    }
  ]
}