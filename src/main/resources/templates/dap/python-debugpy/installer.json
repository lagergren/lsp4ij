{
  "id": "debugpy",
  "name": "Install and verify debugpy DAP Server",
  "check": {
    "exec": {
      "name": "Check if debugpy is installed",
      "command": {
        "windows": "python -m debugpy --version",
        "default": "python3 -m debugpy --version"
      },
      "ignoreStderr": true,
      "timeout": 10000
    }
  },
  "run": {
    "exec": {
      "name": "Install 'debugpy'",
      "ignoreStderr": true,
      "command": {
        "windows": "python -m pip install debugpy",
        "default": "python3 -m pip install debugpy"
      }
    }
  }
}
