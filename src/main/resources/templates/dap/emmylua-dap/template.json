    "windows": "<<insert base directory>>/emmylua_dap.exe",
    "default": "<<insert base directory>>/emmylua_dap"
  },
  "fileTypeMappings": [
    {
      "fileType": {
        "name": "Lua",
        "patterns": [
          "*.lua"
        ]
      }
    }
  ]
}
