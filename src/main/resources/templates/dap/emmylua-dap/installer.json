{
  "id": "emmylua-dap",
  "name": "EmmyLua Debug Adapter (Lua)",
  "properties": {
    "serverDist": "$USER_HOME$/.lsp4ij/dap/emmylua-dap"
  },
  "check": {
    "fileExists": {
      "name": "Check if emmylua_dap is installed",
      "file": {
        "windows": "${serverDist}/emmylua_dap.exe",
        "default": "${serverDist}/emmylua_dap"
      },
      "onSuccess": {
        "replaceTemplateCommand": {
          "name": "Configure emmylua_dap command",
          "templateCommand": {
            "windows": "<<insert base directory>>/emmylua_dap.exe",
            "default": "<<insert base directory>>/emmylua_dap"
          },
          "command": "\"${check.file}\""
        }
      }
    }
  },
  "run": {
    "download": {
      "name": "Download emmylua_dap",
      "github": {
        "owner": "EmmyLuaLs",
        "repository": "emmylua_dap",
        "prerelease": false,
        "asset": {
          "windows": {
            "x86_64": "emmylua_dap-win32-x64.zip",
            "x86": "emmylua_dap-win32-ia32.zip",
            "arm64": "emmylua_dap-win32-arm64.zip"
          },
          "unix": {
            "x86_64": "emmylua_dap-linux-x64-glibc.2.17.tar.gz",
            "arm64": "emmylua_dap-linux-aarch64-glibc.2.17.tar.gz"
          },
          "mac": {
            "x86_64": "emmylua_dap-darwin-x64.tar.gz",
            "arm64": "emmylua_dap-darwin-arm64.tar.gz"
          }
        }
      },
      "url": {
        "windows": {
          "x86_64": "https://github.com/EmmyLuaLs/emmylua_dap/releases/download/0.5.0/emmylua_dap-win32-x64.zip",
          "x86": "https://github.com/EmmyLuaLs/emmylua_dap/releases/download/0.5.0/emmylua_dap-win32-ia32.zip",
          "arm64": "https://github.com/EmmyLuaLs/emmylua_dap/releases/download/0.5.0/emmylua_dap-win32-arm64.zip"
        },
        "unix": {
          "x86_64": "https://github.com/EmmyLuaLs/emmylua_dap/releases/download/0.5.0/emmylua_dap-linux-x64-glibc.2.17.tar.gz",
          "arm64": "https://github.com/EmmyLuaLs/emmylua_dap/releases/download/0.5.0/emmylua_dap-linux-aarch64-glibc.2.17.tar.gz"
        },
        "mac": {
          "x86_64": "https://github.com/EmmyLuaLs/emmylua_dap/releases/download/0.5.0/emmylua_dap-darwin-x64.tar.gz",
          "arm64": "https://github.com/EmmyLuaLs/emmylua_dap/releases/download/0.5.0/emmylua_dap-darwin-arm64.tar.gz"
        }
      },
      "output": {
        "dir": "${serverDist}",
        "stripRootFolder": true,
        "file": {
          "name": {
            "windows": "emmylua_dap.exe",
            "unix": "emmylua_dap",
            "mac": "emmylua_dap"
          },
          "executable": true
        }
      },
      "onSuccess": {
        "configureServer": {
          "name": "Configure emmylua_dap command",
          "command": "\"${output.dir}/${output.file.name}\"",
          "update": true
        }
      }
    }
  }
}
