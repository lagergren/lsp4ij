{
  "id": "lua-language-server",
  "name": "Lua Language Server (LuaLS)",
  "programArgs": {
    "default": "lua-language-server"
  },
  "expandConfiguration": true,
  "fileTypeMappings": [
    {
      "fileType": {
        "name": "Lua",
        "patterns": [
          "*.lua"
        ]
      },
      "languageId": "lua"
    }
  ]
}
